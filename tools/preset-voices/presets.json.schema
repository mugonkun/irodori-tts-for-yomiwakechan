{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mugonkun/irodori-tts-for-yomiwakechan/tools/preset-voices/presets.json.schema",
  "title": "便 P — プリセット話者の台帳（voices/presets.json）",
  "description": "decisions.md 17・18・26・27 が正典。リリース版に同梱するテンプレート参照ボイス 12 名の台帳。二次 wav が実体の参照ボイス（voices/presets/<id>.wav）で、一次 wav は素材＝配布物には入れない（build/out/preset-work/primary/ と N:/temp_for_claudecode_agents/irodori-ywk/preset-voices/primary/ に保全）。",
  "type": "object",
  "required": ["version", "generated_at", "presets"],
  "additionalProperties": true,

  "properties": {
    "version": { "type": "integer", "minimum": 1, "description": "台帳の書式版。" },
    "generated_at": { "type": "string", "description": "この台帳を書き出した時刻（ISO 8601）。" },
    "corpus": { "type": "string", "description": "本文の出所（例 tools/preset-voices/corpus.json）。" },
    "notes": { "type": "array", "items": { "type": "string" } },

    "presets": {
      "type": "array",
      "description": "話者 12 名。status が pending のものは一次 wav がまだ無い（VOICEROID2 4 名・CeVIO AI 1 名）。",
      "items": { "$ref": "#/$defs/preset" }
    }
  },

  "$defs": {
    "preset": {
      "type": "object",
      "required": ["id", "display_name", "engine", "engine_speaker", "style", "rights_note", "status"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{2,47}$",
          "description": "ASCII の識別子。参照ボイス檔名（<id>.wav）と Irodori の voice id を兼ねる。例 vv_mochiko_sexy・co_tsukuyomi・vr2_akane_west。接頭辞＝vv_（VOICEVOX）・co_（COEIROINK）・vr2_（VOICEROID2）・cevio_（CeVIO AI）。"
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "description": "日本語の表示名＝本体（yomiwakechan2）に見せる話者名。そのまま話者 id になる（裁定 17）。例「つくよみちゃん」「ちび式じい」。同じ話者で複数スタイルがある場合は「おふとんP（きざ）」のようにスタイルを添える。司令官が名を指したときも同じ形で添える＝「もち子さん（セクシー／あん子）」（裁定 108）。"
        },
        "engine": {
          "type": "string",
          "enum": ["voicevox", "coeiroink", "voiceroid2", "cevio_ai"],
          "description": "一次 wav を作ったエンジン。"
        },
        "engine_speaker": {
          "type": "string",
          "description": "エンジン内での話者名（原文）。例「もち子さん」「KANA」「琴葉 茜」。"
        },
        "speaker_uuid": {
          "type": ["string", "null"],
          "description": "COEIROINK の speakerUuid。他エンジンでは null。"
        },
        "style": {
          "type": "object",
          "required": ["name"],
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string", "description": "スタイル名（原文）。例「セクシー／あん子」「ないしょばなし」。" },
            "id": {
              "type": ["integer", "string", "null"],
              "description": "エンジン内のスタイル id。VOICEVOX＝styleId(int)・COEIROINK＝styleId(int)・VOICEROID2＝プリセット名やボイス名(str)・無い場合 null。"
            }
          }
        },
        "status": {
          "type": "string",
          "enum": ["done", "pending", "skipped"],
          "description": "done＝一次と二次が揃った／pending＝一次 wav 待ち（VOICEROID2 は別席 G3）／skipped＝decisions 27 で今回は飛ばす（CeVIO AI 弦巻マキ 英）。"
        },

        "primary": {
          "type": ["object", "null"],
          "description": "エンジンが読んだ素の地の文の wav（素材・配布物には入れない）。null＝まだ無い。",
          "required": ["file", "duration_s", "sample_rate"],
          "additionalProperties": false,
          "properties": {
            "file": { "type": "string", "description": "檔名（例 vv_mochiko_sexy_30s.wav）。置き場＝build/out/preset-work/primary/ と N: の写し。" },
            "file_10s": { "type": ["string", "null"], "description": "10 s 版の檔名（比較用）。" },
            "duration_s": { "type": "number", "description": "実測秒数（verify_wavs.py）。" },
            "duration_10s_s": { "type": ["number", "null"] },
            "sample_rate": { "type": "integer", "description": "Hz。VOICEVOX＝24000・COEIROINK＝44100。" },
            "channels": { "type": "integer" },
            "bits": { "type": "integer" },
            "text_id": { "type": "string", "description": "corpus.json の primary のどれか（text_30s / text_10s）。" },
            "peak_dbfs": { "type": ["number", "null"] },
            "rms_dbfs": { "type": ["number", "null"] }
          }
        },

        "secondary": {
          "type": ["object", "null"],
          "description": "一次を参照ボイスにして Irodori-TTS-Server で合成した wav＝これがリリース版のテンプレート参照ボイス。実体＝voices/presets/<id>.wav。md5・size_bytes はその実檔から測った値（make_presets.py が書く）。",
          "required": ["file", "md5", "size_bytes", "duration_s", "sample_rate", "text", "irodori", "tail"],
          "additionalProperties": false,
          "properties": {
            "file": { "type": "string", "description": "檔名（<id>.wav）。置き場＝voices/presets/。" },
            "md5": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$",
              "description": "voices/presets/<id>.wav の MD5（小文字 32 桁）。受け渡し先（N:）の写しとの突合に使う。"
            },
            "size_bytes": {
              "type": "integer",
              "minimum": 1,
              "description": "voices/presets/<id>.wav の実バイト数。"
            },
            "duration_s": { "type": "number" },
            "sample_rate": { "type": "integer" },
            "channels": { "type": "integer" },
            "bits": { "type": "integer" },
            "peak_dbfs": { "type": ["number", "null"] },
            "rms_dbfs": { "type": ["number", "null"] },
            "text_id": { "type": "string", "description": "corpus.json の secondary のどれか（expressive_30s / greeting_10s）。" },
            "text": { "type": "string", "description": "生成に使った本文（逐語）。" },
            "ref_variant": {
              "type": "string",
              "enum": ["30s", "10s"],
              "description": "参照に使った一次 wav の版。既定は 30s。"
            },
            "ref_10s_file": { "type": ["string", "null"], "description": "10 s 参照で作った比較用二次 wav（<id>_ref10_secondary.wav）。採用しなかった側は配布しない。" },
            "irodori": {
              "type": "object",
              "description": "生成に使った irodori パラメータ（POST /v1/audio/speech の irodori 欄）。",
              "required": ["num_steps", "seed"],
              "additionalProperties": true,
              "properties": {
                "num_steps": { "type": "integer", "description": "decisions 10＝既定 40。" },
                "seed": { "type": "integer", "description": "再現のため固定。話者ごとに違うことがある＝末尾切れの是正（decisions 39）で seed を掃引して採った値。" },
                "trim_tail": { "type": "boolean", "description": "上流 SamplingRequest.trim_tail（既定 true＝潜在の平坦点で末尾を切る）。seed 掃引で clean が出ず false にした話者だけ現れる。" },
                "cfg_scale_speaker": {
                  "type": "number",
                  "description": "参照ボイス（話者）への寄せ具合＝上流 SamplingRequest.cfg_scale_speaker。欄が無い行は撃った時に明示していない＝上流既定 5.0（Irodori-TTS-Server config.py default_cfg_scale_speaker）で撃った。裁定 111＝司令官「２次生成ボイスが途中から参照ボイスになってないね。CFG Scale Speaker を 2 ほど上げて再生成を頼む」（2026-09-09）により、KANA ないしょばなし・おふとんP きざ・琴葉茜（関西弁）の 3 名だけ 7.0 で撃ち直した。"
                },
                "seed_sweep": {
                  "type": "object",
                  "description": "decisions 39 の seed 掃引の記録（掃引して採った話者だけ）。",
                  "additionalProperties": true,
                  "properties": {
                    "seeds": {
                      "type": "array",
                      "items": { "type": "integer" },
                      "description": "その話者に用意した seed の列。掃引を 2 度回すと話者ごとに起点が違う（規則を強めたあと、月読アイと ちび式じい だけ 1235 から撃ち直した）ので、話者ごとに別の列が入りうる。前の run で書かれた行は列そのものが残っていないので、実際に撃った seed（seeds_tried）が入る。"
                    },
                    "seeds_tried": {
                      "type": "array",
                      "items": { "type": "integer" },
                      "description": "実際に撃った seed（clean が出た時点で止まるので seeds より短いことが多い）。"
                    },
                    "adopted_seed": { "type": "integer" },
                    "adopted_trim_tail": { "type": "boolean" },
                    "tries": { "type": "integer", "description": "clean が出るまでに撃った回数。" },
                    "tail_rule": { "type": "string", "description": "その掃引で clean の判定に使った規則の逐語。" }
                  }
                }
              }
            },
            "tail": {
              "type": "object",
              "description": "末尾判定（decisions 39・tools/preset-voices/verify_wavs.py）。3 条件すべてを満たしたときだけ clean＝⒜ 末尾 50 ms の RMS が全体 RMS より 20 dB 以上低い／⒝ その RMS が絶対値で −40 dBFS 以下／⒞ 末尾 300 ms を 25 ms 刻みに割り、最後の 100 ms の各区間が直前より +0.5 dB を超えて上がらない（−60 dBFS 以下は無音として除く）。1 つでも外れたら tail_suspect（語の途中で終端している疑い）。⒜ だけだった旧規則は、いったん無音に落ちてから鳴り出して切れる檔を Δ=−20.19 dB の縁で通してしまった。",
              "required": ["verdict", "rule"],
              "additionalProperties": true,
              "properties": {
                "window_ms": { "type": ["number", "null"], "description": "⒜⒝ が見る末尾の窓（ミリ秒・既定 50）。" },
                "tail_rms_dbfs": { "type": ["number", "null"], "description": "末尾 50 ms の RMS（dBFS）。振幅ちょうど 0 なら null。" },
                "tail_delta_db": { "type": ["number", "null"], "description": "⒜ tail_rms_dbfs − rms_dbfs。−20 以下なら合格。末尾が振幅 0 なら null。" },
                "margin_db": { "type": ["number", "null"], "description": "⒜ の閾（既定 20 dB）。" },
                "delta_clean": { "type": ["boolean", "null"], "description": "⒜ を満たしたか。" },
                "abs_dbfs": { "type": ["number", "null"], "description": "⒝ の閾（既定 −40 dBFS）。" },
                "abs_clean": { "type": ["boolean", "null"], "description": "⒝ を満たしたか。" },
                "profile_ms": { "type": ["number", "null"], "description": "⒞ 形を見る末尾の長さ（既定 300 ms）。" },
                "step_ms": { "type": ["number", "null"], "description": "⒞ 刻み（既定 25 ms）。" },
                "final_ms": { "type": ["number", "null"], "description": "⒞ 立ち上がりを許さない末端の長さ（既定 100 ms）。" },
                "floor_dbfs": { "type": ["number", "null"], "description": "⒞ これ以下の区間は無音として立ち上がりに数えない（既定 −60 dBFS）。" },
                "rise_limit_db": { "type": ["number", "null"], "description": "⒞ 区間ごとに許す立ち上がり（既定 +0.5 dB）。" },
                "rise_db": { "type": ["number", "null"], "description": "⒞ 最後の 100 ms で実測した最大の立ち上がり。末端が全部無音なら null。" },
                "rise_clean": { "type": ["boolean", "null"], "description": "⒞ を満たしたか。" },
                "profile_dbfs": {
                  "type": ["array", "null"],
                  "items": { "type": ["number", "null"] },
                  "description": "末尾 300 ms を 25 ms 刻みで測った RMS(dBFS) の並び（古い順・12 個）。振幅 0 の区間は null。司令官が目で末尾の形を追えるように残す。"
                },
                "fail_reasons": {
                  "type": "array",
                  "items": { "type": "string", "enum": ["delta", "abs", "rise"] },
                  "description": "外れた条件。空なら clean。"
                },
                "rule": { "type": "string", "description": "適用した規則の逐語（verify_wavs.tail_rule_text）。" },
                "verdict": { "type": ["string", "null"], "enum": ["clean", "tail_suspect", null] }
              }
            },
            "server": {
              "type": "object",
              "description": "生成に使ったサーバの素性。",
              "additionalProperties": true,
              "properties": {
                "hf_checkpoint": { "type": "string" },
                "model_precision": { "type": "string" },
                "codec_precision": { "type": "string" },
                "port": { "type": "integer" },
                "device": { "type": "string" }
              }
            },
            "elapsed_s": { "type": ["number", "null"], "description": "合成にかかった秒数。" }
          }
        },

        "rights_note": {
          "type": "string",
          "minLength": 1,
          "description": "権利の注記。decisions 18＝司令官が「個人利用・商用・有償でも再配布可」と確認済み（確認日 2026-09-04）。ただし席は推測で断定しない＝規約原文の所在と確認日付を licenses/ の台帳に記す。この欄には『誰が・いつ確認したか』と『規約原文は未取得』の別を必ず書く。"
        },
        "rights_confirmed_by": { "type": "string", "description": "例「司令官（mugonkun）」。" },
        "rights_confirmed_at": { "type": "string", "description": "確認日（例 2026-09-04）。" },
        "rights_source_fetched": {
          "type": "boolean",
          "description": "各エンジン／キャラの規約原文を席が取得して読んだか。false＝未取得（司令官の口頭確認のみ）。"
        },
        "generated_at": { "type": "string", "description": "この 1 名の二次 wav を作った時刻（ISO 8601）。" }
      }
    }
  }
}
