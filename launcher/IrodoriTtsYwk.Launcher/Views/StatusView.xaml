<UserControl x:Class="IrodoriTtsYwk.Launcher.Views.StatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:IrodoriTtsYwk.Launcher.ViewModels"
             AutomationProperties.AutomationId="StatusView">
  <!--
    詳しい状態（v2.0 段 C・A-4／A-5・v2-spec.md §2-2）。束縛先は ViewModels/StatusViewModel。
    UIA 検分（受け入れ条件 D-7）のために、読む値と押す物すべてに AutomationId を付ける。

    **畳みの外は 4 つだけ**＝⒜ 大きな 1 行 ⒝ 止まった理由 ⒞ 準備が要る／一式を入れ直す
    ⒟「動かない」に直結する告知（設定の保留・グラフィックスの食い違い）。
    それ以外は StatusAdvancedExpander（既定は閉・**11 行**・上限 12 行＝憲章 原則 7）の中へ移した。
    **要素も id も 1 つも消していない**＝入り切らない物は行を畳んで同居させる。

    文言は ViewModels/UiStrings.cs が唯一の出所である（段 C・v2-plan.md C-1）＝
    ここに日本語を直に書かない。WordLintTests が可視属性を舐めて隠す語 0 件を見る。
  -->
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <Style x:Key="LabelText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#555555" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="ValueText" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,0,24,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="Note" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#666666" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,2,0,0" />
    </Style>
  </UserControl.Resources>

  <DockPanel Margin="12">

    <!-- 1 行目＝いまの様子と理由（受け入れ条件 D-1＝理由 1 行が必ず出る） -->
    <Border DockPanel.Dock="Top" Padding="12,10" Background="#EEF3FA" CornerRadius="4">
      <StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="{x:Static vm:UiStrings.StatusStateLabel}" Style="{StaticResource LabelText}" />
          <TextBlock x:Name="StateValue" FontSize="18" FontWeight="Bold"
                     AutomationProperties.AutomationId="StatusStateText"
                     Text="{Binding StateText, Mode=OneWay}" />
        </StackPanel>
        <!--
          止まった理由＝**§2-1a の 3 部品を帯と共用する**（v2-spec.md §2-2 の 2 行目）。
          束縛先は BandReasonText であって内部の Reason ではない（是正・段 C の検分）＝
          Reason は状態機械・門・GpuEnumerator が綴る工学の 1 行で、ここに直に出すと
          「実行系を起こす段が …」「…（裁定 83）」がそのまま画面に載った（憲章 原則 6）。
          内部の 1 行は BandText.For が見分けて言い直し、原文は記録の檔と StatusLogBox に残る。
        -->
        <TextBlock AutomationProperties.AutomationId="StatusReasonText"
                   Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#A03030"
                   Text="{Binding BandReasonText, Mode=OneWay}"
                   Visibility="{Binding HasBandReason, Converter={StaticResource BoolToVis}}" />
        <!-- 選んだ GPU と、実際に載った GPU の突合（裁定 34＝同定は UUID）。
             「動かない」に直結するので畳みの外（v2-spec.md §2-2）。 -->
        <TextBlock AutomationProperties.AutomationId="StatusGpuMismatchText"
                   Margin="0,4,0,0" TextWrapping="Wrap" Foreground="#A05000"
                   Text="{Binding GpuMismatch, Mode=OneWay}" />
        <!-- 走行中に「適用」した設定は次回の起動から効く。 -->
        <TextBlock AutomationProperties.AutomationId="StatusSettingsPendingText"
                   Margin="0,4,0,0" TextWrapping="Wrap" Foreground="#606060"
                   Text="{Binding SettingsPendingText, Mode=OneWay}" />
        <!--
          裁定 121＝準備が未了（動かすための一式か声のデータが無い）で断られた／落ちた回だけ、
          はじめの準備への 1 手を出す（押すとウィザードが開く＝窓が繋ぐ）。
        -->
        <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                    Visibility="{Binding AcquisitionNeeded, Converter={StaticResource BoolToVis}}">
          <TextBlock AutomationProperties.AutomationId="StatusAcquisitionText"
                     VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#A03030"
                     Text="{Binding AcquisitionText, Mode=OneWay}" />
          <Button Content="{x:Static vm:UiStrings.StatusAcquireButton}" Padding="12,4" Margin="12,0,0,0"
                  AutomationProperties.AutomationId="StatusAcquireButton"
                  Click="OnAcquireClick" />
        </StackPanel>
        <!--
          裁定 91＝アプリが持っている一式の控えと、いま入っている一式が食い違っている。
          押すと一時ファイルから組み直し、原檔が無ければダウンロードから。
        -->
        <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                    Visibility="{Binding CanRebuildRuntime, Converter={StaticResource BoolToVis}}">
          <TextBlock AutomationProperties.AutomationId="StatusRebuildRuntimeText"
                     VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#A03030"
                     Text="{Binding RebuildRuntimeText, Mode=OneWay}" />
          <Button Content="{x:Static vm:UiStrings.StatusRebuildButton}" Padding="12,4" Margin="12,0,0,0"
                  AutomationProperties.AutomationId="StatusRebuildRuntimeButton"
                  Command="{Binding RebuildRuntimeCommand}" />
        </StackPanel>
        <!-- 入れ直しの帯と「やめる」（是正・便 D（3）の 3 巡目）。 -->
        <StackPanel Margin="0,6,0,0"
                    Visibility="{Binding IsRebuilding, Converter={StaticResource BoolToVis}}">
          <StackPanel Orientation="Horizontal">
            <TextBlock AutomationProperties.AutomationId="StatusRebuildProgressText"
                       VerticalAlignment="Center" TextWrapping="Wrap"
                       Text="{Binding RebuildProgressText, Mode=OneWay}" />
            <Button Content="{x:Static vm:UiStrings.StatusRebuildCancelButton}" Padding="12,4" Margin="12,0,0,0"
                    AutomationProperties.AutomationId="StatusRebuildCancelButton"
                    Command="{Binding CancelRebuildCommand}" />
          </StackPanel>
          <ProgressBar Height="6" Margin="0,4,0,0" Minimum="0" Maximum="1"
                       AutomationProperties.AutomationId="StatusRebuildProgressBar"
                       Value="{Binding RebuildProgressFraction, Mode=OneWay}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!--
      詳細（上級者向け）＝**11 行**（上限 12 行・憲章 原則 7）。既定は閉。
      台本は Open-YwkFold -Id 'StatusAdvancedExpander' の 1 手で開ける（v2-plan.md A-0）。
      **消した物（移さない）**＝GPU の UUID 下 6 桁・GPU メモリの長い註・つなぎ口の行。
      つなぎ口の番号 18088 を出す面は 1 つだけ＝埋まって起動できないときの帯（憲章 原則 5 の例外）。
    -->
    <Expander x:Name="AdvancedExpander" DockPanel.Dock="Top" Margin="0,12,0,0" IsExpanded="False"
              AutomationProperties.AutomationId="StatusAdvancedExpander"
              Header="{x:Static vm:UiStrings.AdvancedHeader}">
      <Grid Margin="12,8,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource Note}"
                   Text="{x:Static vm:UiStrings.AdvancedIntro}" />

        <!-- 1＝使うグラフィックス（UUID の下 6 桁は文から落とした） -->
        <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,8,8,0"
                   Text="{x:Static vm:UiStrings.StatusGpuLabel}" Style="{StaticResource LabelText}" />
        <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,8,0,0"
                   AutomationProperties.AutomationId="StatusGpuText"
                   Style="{StaticResource ValueText}" Text="{Binding GpuText, Mode=OneWay}" />

        <!-- 2＝いま動いている場所 -->
        <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,6,8,0"
                   Text="{x:Static vm:UiStrings.StatusDeviceLabel}" Style="{StaticResource LabelText}" />
        <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,6,0,0"
                   AutomationProperties.AutomationId="StatusDeviceText"
                   Style="{StaticResource ValueText}" Text="{Binding DeviceText, Mode=OneWay}" />

        <!-- 3＝動かし方 -->
        <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,6,8,0"
                   Text="{x:Static vm:UiStrings.StatusVariantLabel}" Style="{StaticResource LabelText}" />
        <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,6,0,0"
                   AutomationProperties.AutomationId="StatusVariantText"
                   Style="{StaticResource ValueText}" Text="{Binding VariantText, Mode=OneWay}" />

        <!-- 4＝準備運転（契約 ⑺ 7-2） -->
        <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,6,8,0"
                   Text="{x:Static vm:UiStrings.StatusWarmupLabel}" Style="{StaticResource LabelText}" />
        <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,6,0,0"
                   AutomationProperties.AutomationId="StatusWarmupText"
                   Style="{StaticResource ValueText}" Text="{Binding WarmupText, Mode=OneWay}" />

        <!-- 5＝声の下ごしらえ（契約 ⑺ 7-3） -->
        <TextBlock Grid.Row="5" Grid.Column="0" Margin="0,6,8,0"
                   Text="{x:Static vm:UiStrings.StatusPrecomputeLabel}" Style="{StaticResource LabelText}" />
        <TextBlock Grid.Row="5" Grid.Column="1" Margin="0,6,0,0"
                   AutomationProperties.AutomationId="StatusPrecomputeText"
                   Style="{StaticResource ValueText}" Text="{Binding PrecomputeText, Mode=OneWay}" />

        <!--
          6＝GPU メモリ（裁定 67 ⑵⑶・87 ⑴・110）。**1 行に数える**（v2-spec.md §2-2 の 7）。
          旧い長い註（torch の allocator …）は**消した**＝差し替えは UiStrings.StatusMemoryNote の 1 行。
          声の合計の GB を出すのはこの行だけである。
        -->
        <Border x:Name="MemoryPanel" Grid.Row="6" Grid.ColumnSpan="2" Margin="0,10,0,0" Padding="10,8"
                Background="#F6F6F6" CornerRadius="4"
                AutomationProperties.AutomationId="StatusMemoryPanel"
                Visibility="{Binding MemoryPanelVisible, Converter={StaticResource BoolToVis}}">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{x:Static vm:UiStrings.StatusMemoryLabel}" Style="{StaticResource LabelText}" />
              <TextBlock AutomationProperties.AutomationId="StatusMemoryText"
                         Style="{StaticResource ValueText}" Text="{Binding MemoryText, Mode=OneWay}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
              <TextBlock Text="{x:Static vm:UiStrings.StatusLatentCacheLabel}" Style="{StaticResource LabelText}" />
              <TextBlock AutomationProperties.AutomationId="StatusLatentCacheText"
                         Style="{StaticResource ValueText}" Text="{Binding LatentCacheText, Mode=OneWay}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
              <TextBlock Text="{x:Static vm:UiStrings.StatusVoiceMemoryLabel}" Style="{StaticResource LabelText}" />
              <TextBlock AutomationProperties.AutomationId="StatusVoiceMemoryText"
                         Style="{StaticResource ValueText}" Text="{Binding VoiceMemoryText, Mode=OneWay}" />
            </StackPanel>
            <TextBlock Style="{StaticResource Note}" Text="{x:Static vm:UiStrings.StatusMemoryNote}" />
          </StackPanel>
        </Border>

        <!-- 7＝元になった Irodori-TTS との食い違い -->
        <TextBlock Grid.Row="7" Grid.ColumnSpan="2"
                   AutomationProperties.AutomationId="StatusUpstreamMismatchText"
                   Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#A05000"
                   Text="{Binding UpstreamMismatch, Mode=OneWay}" />

        <!--
          8＝起動のときの告知（裁定 88 ⑴⑵）＝門で断られた理由 1 行と、cu126 の注意を
          **そのまま**出す（畳まない・言い換えない）。この行の中でその掟を守る。
        -->
        <TextBlock Grid.Row="8" Grid.ColumnSpan="2"
                   AutomationProperties.AutomationId="StatusNoticesText"
                   Margin="0,4,0,0" TextWrapping="Wrap" Foreground="#A05000"
                   Text="{Binding NoticesText, Mode=OneWay}" />

        <!--
          つなぎ口の行は置かない＝要素と id は残すが、**番号を常時は出さない**
          （v2-copy.md §4 末尾・v2-spec.md §2-2）。番号は StatusViewModel.EndpointText に在る。
        -->
        <TextBlock Grid.Row="8" Visibility="Collapsed"
                   AutomationProperties.AutomationId="StatusEndpointText"
                   Text="{Binding EndpointText, Mode=OneWay}" />

        <!-- 9＝記録（ここが唯一の生の記録の置き場・高さは 6 行に固定） -->
        <DockPanel Grid.Row="9" Grid.ColumnSpan="2" Margin="0,10,0,0">
          <TextBlock DockPanel.Dock="Top" Text="{x:Static vm:UiStrings.StatusLogLabel}"
                     Style="{StaticResource LabelText}" />
          <TextBox x:Name="LogBox" Height="110"
                   AutomationProperties.AutomationId="StatusLogBox"
                   IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                   VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                   FontFamily="Consolas, MS Gothic"
                   Text="{Binding LogText, Mode=OneWay}"
                   TextChanged="OnLogChanged" />
        </DockPanel>
      </Grid>
    </Expander>

    <Grid />
  </DockPanel>
</UserControl>
