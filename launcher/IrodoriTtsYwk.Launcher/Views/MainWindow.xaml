<Window x:Class="IrodoriTtsYwk.Launcher.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:IrodoriTtsYwk.Launcher.Views"
        Title="irodori-TTS for 読み分けちゃん"
        Height="760" Width="1100"
        MinHeight="520" MinWidth="820"
        WindowStartupLocation="CenterScreen"
        AutomationProperties.AutomationId="MainWindow">
  <!--
    上の Title は**設計時（デザイナ）用の見本**であって落ち先ではない。実行時は必ず
    MainWindow.xaml.cs が ReleaseFlavors.AppTitle で「（CUDA 版）」「（ROCm 版）」を足して
    差し替える＝裁定 109（樹が読めないときは CUDA 版と名乗る＝DetectFrom は投げない）。

    主窓＝5 つのタブ（状態・話者・試し撃ち・設定・このアプリについて）と、
    どのタブからでも押せる起動／停止の帯。窓の × は閉じずにトレイへ隠す（常駐が主・裁定 6）。
    束縛先は Views/MainWindow.xaml.cs が組み立てる ViewModel 群。
  -->
  <DockPanel>

    <StatusBar DockPanel.Dock="Bottom">
      <StatusBarItem>
        <TextBlock AutomationProperties.AutomationId="MainStateText"
                   Text="{Binding Status.StateText, Mode=OneWay}" />
      </StatusBarItem>
      <Separator />
      <StatusBarItem>
        <TextBlock AutomationProperties.AutomationId="MainEndpointText"
                   Text="{Binding Status.EndpointText, Mode=OneWay}" />
      </StatusBarItem>
      <Separator />
      <StatusBarItem HorizontalAlignment="Right">
        <TextBlock x:Name="VersionText" AutomationProperties.AutomationId="MainVersionText" />
      </StatusBarItem>
    </StatusBar>

    <Border DockPanel.Dock="Top" Padding="12,10" Background="#F3F3F3">
      <StackPanel Orientation="Horizontal">
        <Button Content="サーバ起動" Padding="14,4"
                AutomationProperties.AutomationId="MainStartButton"
                Command="{Binding Status.StartCommand}" />
        <Button Content="サーバ停止" Padding="14,4" Margin="8,0,0,0"
                AutomationProperties.AutomationId="MainStopButton"
                Command="{Binding Status.StopCommand}" />
        <Button Content="初回取得をやり直す" Padding="10,4" Margin="16,0,0,0"
                AutomationProperties.AutomationId="MainFirstRunButton"
                Click="OnFirstRunClick" />
        <TextBlock x:Name="HeaderText" Margin="16,0,0,0" VerticalAlignment="Center"
                   AutomationProperties.AutomationId="MainHeaderText" />
      </StackPanel>
    </Border>

    <TabControl x:Name="MainTabs" Margin="8"
                AutomationProperties.AutomationId="MainTabs">
      <TabItem Header="状態" AutomationProperties.AutomationId="TabStatus">
        <views:StatusView x:Name="StatusPage" DataContext="{Binding Status}" />
      </TabItem>
      <TabItem Header="話者" AutomationProperties.AutomationId="TabVoices">
        <views:VoicesView DataContext="{Binding Voices}" />
      </TabItem>
      <TabItem Header="試し撃ち" AutomationProperties.AutomationId="TabTry">
        <views:TryView DataContext="{Binding Try}" />
      </TabItem>
      <TabItem Header="設定" AutomationProperties.AutomationId="TabSettings">
        <views:SettingsView DataContext="{Binding Settings}" />
      </TabItem>
      <TabItem Header="このアプリについて" AutomationProperties.AutomationId="TabAbout">
        <views:AboutView DataContext="{Binding About}" />
      </TabItem>
    </TabControl>

  </DockPanel>
</Window>
