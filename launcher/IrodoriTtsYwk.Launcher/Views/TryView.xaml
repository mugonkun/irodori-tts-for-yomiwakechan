<UserControl x:Class="IrodoriTtsYwk.Launcher.Views.TryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:IrodoriTtsYwk.Launcher.ViewModels"
             AutomationProperties.AutomationId="TryView">
  <!--
    発話テスト（タブの表示名＝裁定 116・決裁 130 Q4 が再確認）。機能は裁定 15・内部名は Try のまま。
    しゃべらせる文＋声＋主要な欄→しゃべらせる→もう一度／保存。
    「既定に戻す」は**欄を空にする**ことで表す（契約 ⑶＝載せない欄は既定が効く）。
    再生は −16 dBFS 相当に揃える（裁定 52）。保存は生の wav（揃えない）。
    橙の枠（TryConcurrencyText）は**常設をやめた**＝本体の読み上げが走っている間だけ出す（決裁 130 Q4）。

    右の欄は**ふだん 4 つ**（声・話し方の指示・速さ・品質の 2 択）と
    **詳細（上級者向け）**（TryAdvancedExpander＝歩数の数値欄・3 つの効き・乱数の種）に割った
    （v2.0 段 C／A-5・v2-spec.md §2-4）。**要素も id も 1 つも消していない。**
    文言は ViewModels/UiStrings.cs が唯一の出所である。
  -->
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
  </UserControl.Resources>
  <Grid Margin="12">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="300" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Grid.ColumnSpan="2" Padding="10,8" Background="#FFF6E5" CornerRadius="4"
            Visibility="{Binding ShowConcurrency, Converter={StaticResource BoolToVis}}">
      <TextBlock TextWrapping="Wrap" Foreground="#7A5200"
                 AutomationProperties.AutomationId="TryConcurrencyText"
                 Text="{Binding ConcurrencyText, Mode=OneWay}" />
    </Border>

    <!-- しゃべらせる文 -->
    <DockPanel Grid.Row="1" Grid.Column="0" Margin="0,10,10,0">
      <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
        <TextBlock Text="{x:Static vm:UiStrings.TryInputLabel}" FontWeight="Bold" />
        <TextBlock HorizontalAlignment="Right" Foreground="#666666"
                   AutomationProperties.AutomationId="TryInputLengthText"
                   Text="{Binding InputLengthText, Mode=OneWay}" />
      </DockPanel>
      <TextBox AutomationProperties.AutomationId="TryInputBox"
               AcceptsReturn="True" TextWrapping="Wrap"
               VerticalScrollBarVisibility="Auto"
               Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" />
    </DockPanel>

    <!-- 右の欄＝ふだん 4 つ＋詳細 -->
    <ScrollViewer Grid.Row="1" Grid.Column="1" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="{x:Static vm:UiStrings.TryVoiceLabel}" FontWeight="Bold" />
        <ComboBox Margin="0,2,0,10"
                  AutomationProperties.AutomationId="TryVoiceCombo"
                  ItemsSource="{Binding Voices}"
                  SelectedItem="{Binding SelectedVoice, Mode=TwoWay}" />

        <!-- 品質の 2 択＝既存の 10／40 の釦をそのまま読み替える（id は 1 字も替えない）。 -->
        <TextBlock Text="{x:Static vm:UiStrings.TryQualityLabel}" FontWeight="Bold" />
        <StackPanel Orientation="Horizontal" Margin="0,2,0,10">
          <Button Content="{x:Static vm:UiStrings.TryQualityFast}" Width="72" Padding="0,3" Margin="0,0,6,0"
                  AutomationProperties.AutomationId="TryStepsPreset10"
                  Click="OnSteps10Click" />
          <Button Content="{x:Static vm:UiStrings.TryQualityFine}" Width="72" Padding="0,3"
                  AutomationProperties.AutomationId="TryStepsPreset40"
                  Click="OnSteps40Click" />
        </StackPanel>

        <TextBlock Text="{x:Static vm:UiStrings.TryCaptionLabel}" FontWeight="Bold" TextWrapping="Wrap" />
        <TextBox Margin="0,2,0,10" Height="60" AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 AutomationProperties.AutomationId="TryCaptionBox"
                 Text="{Binding Caption, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Text="{x:Static vm:UiStrings.TrySpeedLabel}" />
        <TextBox Margin="0,2,0,8"
                 AutomationProperties.AutomationId="TrySpeedBox"
                 Text="{Binding SpeedInput, UpdateSourceTrigger=LostFocus}" />

        <Expander Margin="0,8,0,0" IsExpanded="False"
                  AutomationProperties.AutomationId="TryAdvancedExpander"
                  Header="{x:Static vm:UiStrings.AdvancedHeader}">
          <StackPanel Margin="8,6,0,0">
            <TextBlock Text="{x:Static vm:UiStrings.TryStepsLabel}" />
            <TextBox Margin="0,2,0,8"
                     AutomationProperties.AutomationId="TryStepsBox"
                     Text="{Binding NumStepsInput, UpdateSourceTrigger=LostFocus}" />

            <TextBlock Text="{x:Static vm:UiStrings.TryCfgTextLabel}" />
            <TextBox Margin="0,2,0,8"
                     AutomationProperties.AutomationId="TryCfgTextBox"
                     Text="{Binding CfgScaleTextInput, UpdateSourceTrigger=LostFocus}" />

            <TextBlock Text="{x:Static vm:UiStrings.TryCfgCaptionLabel}" />
            <TextBox Margin="0,2,0,8"
                     AutomationProperties.AutomationId="TryCfgCaptionBox"
                     Text="{Binding CfgScaleCaptionInput, UpdateSourceTrigger=LostFocus}" />

            <TextBlock Text="{x:Static vm:UiStrings.TryCfgSpeakerLabel}" />
            <TextBox Margin="0,2,0,8"
                     AutomationProperties.AutomationId="TryCfgSpeakerBox"
                     Text="{Binding CfgScaleSpeakerInput, UpdateSourceTrigger=LostFocus}" />

            <TextBlock Text="{x:Static vm:UiStrings.TrySeedLabel}" />
            <TextBox Margin="0,2,0,8"
                     AutomationProperties.AutomationId="TrySeedBox"
                     Text="{Binding Seed, UpdateSourceTrigger=LostFocus}" />

            <!-- 所要と RTF の内訳はここにだけ出す（憲章 §6-1＝詳細の外へ出さない）。 -->
            <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Foreground="#555555"
                       AutomationProperties.AutomationId="TryDetailText"
                       Text="{Binding DetailText, Mode=OneWay}" />
          </StackPanel>
        </Expander>
      </StackPanel>
    </ScrollViewer>

    <!-- 操作 -->
    <WrapPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,10,0,0">
      <Button Content="{x:Static vm:UiStrings.TrySynthesizeButton}" Padding="16,5" Margin="0,0,8,6"
              AutomationProperties.AutomationId="TrySynthesizeButton"
              Command="{Binding SynthesizeCommand}" />
      <Button Content="{x:Static vm:UiStrings.TryReplayButton}" Padding="12,5" Margin="0,0,8,6"
              AutomationProperties.AutomationId="TryReplayButton"
              Command="{Binding ReplayCommand}" />
      <Button Content="{x:Static vm:UiStrings.TryStopButton}" Padding="12,5" Margin="0,0,8,6"
              AutomationProperties.AutomationId="TryStopButton"
              Command="{Binding StopCommand}" />
      <Button Content="{x:Static vm:UiStrings.TrySaveButton}" Padding="12,5" Margin="0,0,8,6"
              AutomationProperties.AutomationId="TrySaveButton"
              Click="OnSaveClick" />
      <TextBlock VerticalAlignment="Center" Margin="12,0,0,0"
                 AutomationProperties.AutomationId="TryResultText"
                 Text="{Binding ResultText, Mode=OneWay}" />
    </WrapPanel>

    <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Margin="0,8,0,0" TextWrapping="Wrap"
               AutomationProperties.AutomationId="TryMessageText"
               Text="{Binding Message, Mode=OneWay}" />
  </Grid>
</UserControl>
