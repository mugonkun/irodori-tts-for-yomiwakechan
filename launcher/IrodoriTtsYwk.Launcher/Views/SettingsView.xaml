<UserControl x:Class="IrodoriTtsYwk.Launcher.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:IrodoriTtsYwk.Launcher.ViewModels"
             AutomationProperties.AutomationId="SettingsView">
  <!--
    設定（設計書 §3・§5・裁定 65・67・69）。編集は写しの上で行い「適用」で初めて書く。

    v2.0 段 C／A-5＝**上はふだんの設定 4 つだけ**（v2-spec.md §2-5・v2-copy.md §4）＝
    ⑴ 自動で読み上げできるようにする ⑵ よく使う声を先に準備しておく
    ⑶ 声のファイルの場所 ⑷ ログを開く。**それ以外は 詳細 か 削除**である。
    詳細（SettingsAdvancedExpander・既定は閉）は **8 行**（段 F で 6 行目が入った）＝
    ⑴ 使うグラフィックス ⑵ 動かし方 ⑶ 音質と速さ ⑷ 声の下ごしらえ ⑸ 読み上げの動作
    ⑹ 更新のとき、新しくなった分だけ取り直す ⑺ ファイルの場所 ⑻ 一時ファイル。
    **上限 12 行**（憲章 原則 7）に収まっている。
    v2-copy.md §4 の 10 行との差は 2 つ＝⒜ 9 行目「記録」は
    ふだんの設定の側の SettingsOpenLogButton 1 つに寄せた ⒝ 10 行目「変えた設定は…」＋
    〔適用〕〔取り消し〕は**畳みの外**（この下の DockPanel.Dock="Bottom"）に置いた＝
    ふだんの 4 つを保存する道が畳みの中にあると行き止まりになるため。

    **入らなかったので消した物（移さない）**＝GPU の UUID の 1 行・
    SettingsShowMemoryCheck・SettingsWarmupStagesBox／SettingsWarmupVoicesBox・
    SettingsEmptyCacheBox／SettingsEmptyCacheNoteText・SettingsReadyTimeoutBox／
    SettingsReadyTimeoutNoteText・つなぎ口の行（7 つの id を退役＝launcher/README §7-3）。
    **settings.json の鍵は 1 つも減らしていない**＝手で書けば従来どおり効く。
    SettingsPortBox／SettingsPortNoteText は**要素と id を残し、番号を常時は出さない**＝
    18088 を出す面は「埋まって起動できないときの帯」1 つだけ（憲章 原則 5 の唯一の例外）。

    文言は ViewModels/UiStrings.cs が唯一の出所である（段 C・v2-plan.md C-1）。
  -->
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <Style x:Key="Head" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Margin" Value="0,14,0,6" />
    </Style>
    <Style x:Key="Note" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#666666" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,2,0,0" />
    </Style>
  </UserControl.Resources>

  <DockPanel Margin="12">

    <!--
      v2-copy.md §4 の 10 行目（変えた設定がいつ効くか＋〔適用〕〔取り消し〕）＝
      **畳みの外に置いた**（意図した外れ・段 C の記帳）。ふだんの設定 4 つを変えた利用者が
      保存するのに「詳細（上級者向け）」を開かねばならない形にしないため。
      したがって詳細の行数には数えない（上の註）。
    -->
    <Border DockPanel.Dock="Bottom" Padding="0,10,0,0">
      <StackPanel>
        <TextBlock Style="{StaticResource Note}" Text="{x:Static vm:UiStrings.SettingsApplyNote}" />
        <WrapPanel Margin="0,6,0,0">
          <Button Content="{x:Static vm:UiStrings.SettingsApplyButton}" Padding="18,5" Margin="0,0,8,0"
                  AutomationProperties.AutomationId="SettingsApplyButton"
                  Command="{Binding ApplyCommand}" />
          <Button Content="{x:Static vm:UiStrings.SettingsRevertButton}" Padding="14,5"
                  AutomationProperties.AutomationId="SettingsRevertButton"
                  Command="{Binding RevertCommand}" />
        </WrapPanel>
        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap"
                   AutomationProperties.AutomationId="SettingsMessageText"
                   Text="{Binding Message, Mode=OneWay}" />
      </StackPanel>
    </Border>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel MaxWidth="720" HorizontalAlignment="Left">

        <!-- ===== ふだんの設定（4 つだけ）===== -->

        <CheckBox Margin="0,4,0,0" Content="{x:Static vm:UiStrings.SettingsAutoStart}"
                  AutomationProperties.AutomationId="SettingsAutoStartCheck"
                  IsChecked="{Binding AutoStartServer, Mode=TwoWay}" />

        <CheckBox Margin="0,10,0,0" Content="{x:Static vm:UiStrings.SettingsWarmup}"
                  AutomationProperties.AutomationId="SettingsWarmupCheck"
                  IsChecked="{Binding WarmupOnStart, Mode=TwoWay}" />
        <TextBlock Style="{StaticResource Note}" Text="{x:Static vm:UiStrings.SettingsWarmupNote}" />

        <TextBlock Text="{x:Static vm:UiStrings.SettingsVoicesDirLabel}" Style="{StaticResource Head}" />
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="{x:Static vm:UiStrings.SettingsOpenFolderButton}"
                  Padding="12,3" Margin="8,0,0,0"
                  AutomationProperties.AutomationId="SettingsOpenVoicesDirButton"
                  Click="OnOpenVoicesDirClick" />
          <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                     AutomationProperties.AutomationId="SettingsVoicesDirText"
                     Text="{Binding VoicesDirText, Mode=OneWay}" />
        </DockPanel>

        <Button HorizontalAlignment="Left" Margin="0,14,0,0" Padding="14,4"
                Content="{x:Static vm:UiStrings.OpenLogButton}"
                AutomationProperties.AutomationId="SettingsOpenLogButton"
                Click="OnOpenLogClick" />

        <!-- ===== 詳細（上級者向け）＝8 行（上限 12） ===== -->
        <Expander x:Name="AdvancedExpander" Margin="0,18,0,0" IsExpanded="False"
                  AutomationProperties.AutomationId="SettingsAdvancedExpander"
                  Header="{x:Static vm:UiStrings.AdvancedHeader}">
          <StackPanel Margin="12,8,0,0">
            <TextBlock Style="{StaticResource Note}" Text="{x:Static vm:UiStrings.AdvancedIntro}" />

            <!-- 1＝使うグラフィックス（UUID の 1 行は消した） -->
            <TextBlock Text="{x:Static vm:UiStrings.SettingsGpuLabel}" Style="{StaticResource Head}" />
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="{x:Static vm:UiStrings.SettingsRefreshGpuButton}"
                      Padding="12,3" Margin="8,0,0,0"
                      AutomationProperties.AutomationId="SettingsRefreshGpuButton"
                      Command="{Binding RefreshGpusCommand}" />
              <ComboBox AutomationProperties.AutomationId="SettingsGpuCombo"
                        ItemsSource="{Binding Gpus}"
                        SelectedItem="{Binding SelectedGpu, Mode=TwoWay}"
                        DisplayMemberPath="Label" />
            </DockPanel>
            <TextBlock Style="{StaticResource Note}"
                       AutomationProperties.AutomationId="SettingsGpuMessageText"
                       Text="{Binding GpuMessage, Mode=OneWay}" />
            <TextBlock Style="{StaticResource Note}"
                       AutomationProperties.AutomationId="SettingsDriverText"
                       Text="{Binding DriverText, Mode=OneWay}" />

            <!-- 2＝動かし方（押す前に代金を告げる） -->
            <TextBlock Text="{x:Static vm:UiStrings.SettingsVariantLabel}" Style="{StaticResource Head}" />
            <ComboBox AutomationProperties.AutomationId="SettingsVariantCombo"
                      ItemsSource="{Binding VariantChoices}"
                      SelectedItem="{Binding Variant, Mode=TwoWay}" />
            <TextBlock Style="{StaticResource Note}"
                       AutomationProperties.AutomationId="SettingsVariantNameText"
                       Text="{Binding VariantDisplayName, Mode=OneWay}" />
            <TextBlock Style="{StaticResource Note}" Text="{x:Static vm:UiStrings.SettingsVariantNote}" />
            <!-- 下限に届かないドライバの動かし方を選んでいる間の 1 行（裁定 126 の B）＝「適用」が断る。 -->
            <TextBlock Style="{StaticResource Note}" FontWeight="Bold" Foreground="#B00020"
                       AutomationProperties.AutomationId="SettingsVariantBlockText"
                       Visibility="{Binding VariantBlocked, Converter={StaticResource BoolToVis}}"
                       Text="{Binding VariantBlockReason, Mode=OneWay}" />

            <!-- 3＝音質と速さ（bf16／FP32 は原語のまま＝憲章 §6-2） -->
            <TextBlock Text="{x:Static vm:UiStrings.SettingsPrecisionLabel}" Style="{StaticResource Head}" />
            <ComboBox AutomationProperties.AutomationId="SettingsPrecisionCombo"
                      ItemsSource="{Binding PrecisionChoices}"
                      SelectedItem="{Binding PrecisionChoice, Mode=TwoWay}"
                      IsEnabled="{Binding PrecisionEnabled, Mode=OneWay}" />
            <TextBlock Style="{StaticResource Note}"
                       AutomationProperties.AutomationId="SettingsPrecisionNoteText"
                       Text="{Binding PrecisionNote, Mode=OneWay}" />

            <!-- 4＝声の下ごしらえ -->
            <TextBlock Text="{x:Static vm:UiStrings.SettingsPrecomputeLabel}" Style="{StaticResource Head}" />
            <CheckBox Content="{x:Static vm:UiStrings.SettingsPrecomputeCheck}"
                      IsThreeState="True"
                      AutomationProperties.AutomationId="SettingsPrecomputeCheck"
                      IsChecked="{Binding PrecomputeOnStart, Mode=TwoWay}" />
            <TextBlock Style="{StaticResource Note}"
                       AutomationProperties.AutomationId="SettingsPrecomputeNoteText"
                       Text="{Binding PrecomputeNote, Mode=OneWay}" />
            <TextBlock Style="{StaticResource Note}" Text="{x:Static vm:UiStrings.SettingsPrecomputeNote}" />

            <!--
              5＝読み上げの動作（v2.0 段 A-1）。主窓の上に在った起動／停止の帯を廃し、3 釦を
              **要素ごと**ここへ移した（AutomationId は 1 字も替えない＝MainStartButton／
              MainStopButton／MainFirstRunButton）。**振る舞いは変わらない**＝AutoStartServer の
              既定は真のままなので、ふだんは誰もこの畳みを開かない。
              `autoStartServer:false` を明示している機体は、帯の〔もう一度動かす〕と
              下の 1 行からここへ辿れる（v2-spec.md §2-5 末尾）。

              束縛の註＝この画面の DataContext は SettingsViewModel なので `Status.StartCommand` は
              当たらない。窓まで登って主 ViewModel の手を取る（Stop も同じ）。
            -->
            <TextBlock Text="{x:Static vm:UiStrings.SettingsRunLabel}" Style="{StaticResource Head}" />
            <WrapPanel>
              <Button Content="{x:Static vm:UiStrings.SettingsStopButton}" Padding="14,4" Margin="0,0,8,0"
                      AutomationProperties.AutomationId="MainStopButton"
                      Command="{Binding DataContext.Status.StopCommand,
                                        RelativeSource={RelativeSource AncestorType=Window}}" />
              <Button Content="{x:Static vm:UiStrings.SettingsStartButton}" Padding="14,4" Margin="0,0,8,0"
                      AutomationProperties.AutomationId="MainStartButton"
                      Command="{Binding DataContext.Status.StartCommand,
                                        RelativeSource={RelativeSource AncestorType=Window}}" />
              <Button Content="{x:Static vm:UiStrings.SettingsFirstRunButton}" Padding="10,4"
                      AutomationProperties.AutomationId="MainFirstRunButton"
                      Click="OnFirstRunClick" />
            </WrapPanel>

            <!--
              6＝更新のとき、新しくなった分だけ取り直す（v2-copy.md §4 の 6 行目・既定 ON）。
              段 E が RuntimeDiff／ModelDiff／PresetSync を入れ、段 F がこの 1 行と更新の道を
              結んだ（MainViewModel.RebuildRuntimeCoreAsync）。**切ると丸ごと入れ直しに戻る**。
            -->
            <CheckBox Margin="0,14,0,0" FontWeight="Bold"
                      Content="{x:Static vm:UiStrings.SettingsDifferentialUpdate}"
                      AutomationProperties.AutomationId="SettingsDifferentialUpdateCheck"
                      IsChecked="{Binding DifferentialUpdate, Mode=TwoWay}" />
            <TextBlock Style="{StaticResource Note}"
                       Text="{x:Static vm:UiStrings.SettingsDifferentialUpdateNote}" />

            <!--
              7＝ファイルの場所（v2-copy.md §4 の 7 行目）。**場所は変えられません。**
              「モデル」と「動かすための一式」の 2 行は「データ」に畳んだ＝要素と id は残す。
              版ごとに別（decisions.md 133）＝RTX（CUDA）は …\irodori-tts-ywk-cuda\。
            -->
            <TextBlock Text="{x:Static vm:UiStrings.SettingsPathsLabel}" Style="{StaticResource Head}" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static vm:UiStrings.SettingsDataDirLabel}"
                         Margin="0,0,10,4" Foreground="#555555" />
              <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,0,0,4" TextTrimming="CharacterEllipsis"
                         AutomationProperties.AutomationId="SettingsDataDirText"
                         Text="{Binding DataDirText, Mode=OneWay}" />
              <Button Grid.Row="0" Grid.Column="2" Padding="12,2" Margin="8,0,0,4"
                      Content="{x:Static vm:UiStrings.SettingsOpenFolderButton}"
                      AutomationProperties.AutomationId="SettingsOpenDataDirButton"
                      Click="OnOpenDataDirClick" />
              <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static vm:UiStrings.SettingsAppDirLabel}"
                         Margin="0,0,10,4" Foreground="#555555" />
              <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,0,0,4" TextTrimming="CharacterEllipsis"
                         AutomationProperties.AutomationId="SettingsAppDirText"
                         Text="{Binding AppDirText, Mode=OneWay}" />
              <!-- 「データ」に畳んだ 2 行＝要素と id は残す（v2-spec.md §2-5 の 7）。 -->
              <TextBlock Grid.Row="1" Visibility="Collapsed"
                         AutomationProperties.AutomationId="SettingsModelDirText"
                         Text="{Binding ModelDirText, Mode=OneWay}" />
              <TextBlock Grid.Row="1" Visibility="Collapsed"
                         AutomationProperties.AutomationId="SettingsRuntimeRootText"
                         Text="{Binding RuntimeRootText, Mode=OneWay}" />
            </Grid>
            <TextBlock Style="{StaticResource Note}" Text="{x:Static vm:UiStrings.SettingsPathsNote}" />

            <!--
              8＝一時ファイル（裁定 90 Q-E2 ⑶）。組み上がれば原檔は要らない。
              初回の合成が 200 で返った時点でアプリが自動で消すので、ここは手で消したいとき用。
            -->
            <TextBlock Text="{x:Static vm:UiStrings.SettingsCacheLabel}" Style="{StaticResource Head}" />
            <Button HorizontalAlignment="Left" Padding="14,5"
                    AutomationProperties.AutomationId="SettingsClearCacheButton"
                    Content="{Binding ClearCacheText, Mode=OneWay}"
                    Command="{Binding ClearCacheCommand}" />
            <TextBlock Style="{StaticResource Note}"
                       AutomationProperties.AutomationId="SettingsCacheMessageText"
                       Text="{Binding CacheMessage, Mode=OneWay}" />
            <TextBlock Style="{StaticResource Note}" Text="{x:Static vm:UiStrings.SettingsCacheNote}" />

            <!--
              8＝記録は**ふだんの設定の側に 1 つだけ**置く（上の SettingsOpenLogButton）。
              同じ 1 手を 2 箇所に置かない＝v2-copy.md §4 の 9 行目と §1-5 の ⑷ は同じ釦である。
            -->

            <!--
              つなぎ口の行は並べない＝**要素と id は残す**（v2-copy.md §4 末尾）。
              手で settings.json を書いた機体でも、この束縛が生きているので値は読み書きできる。
            -->
            <TextBox Visibility="Collapsed" Width="120" HorizontalAlignment="Left"
                     AutomationProperties.AutomationId="SettingsPortBox"
                     Text="{Binding Port, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
            <TextBlock Visibility="Collapsed"
                       AutomationProperties.AutomationId="SettingsPortNoteText"
                       Text="{Binding PortNote, Mode=OneWay}" />
          </StackPanel>
        </Expander>

      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
