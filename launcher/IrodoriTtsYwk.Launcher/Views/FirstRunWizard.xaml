<Window x:Class="IrodoriTtsYwk.Launcher.Views.FirstRunWizard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:IrodoriTtsYwk.Launcher.ViewModels"
        xmlns:v="clr-namespace:IrodoriTtsYwk.Launcher.Views"
        Title="初回取得" Height="640" Width="900"
        MinHeight="480" MinWidth="720"
        WindowStartupLocation="CenterOwner"
        AutomationProperties.AutomationId="FirstRunWizard">
  <!--
    上の Title は設計時（デザイナ）用の見本であって落ち先ではない。実行時は必ず
    FirstRunWizard.xaml.cs が ReleaseFlavors.WizardTitle で差し替える（裁定 109）。

    はじめの準備（v2.0 段 B・v2-spec.md §3・v2-copy.md §2）。
    見える段は 3 つ＝お知らせ（要約＋〔全文を見る〕＋同意 1 度）→ これからすること（選ばせない）
    → 準備しています（1 本のバー・4 段を 1 つに見せる）→ 使えます。
    内部の 7 段（FirstRunStep）は 1 つも触っていない＝ここは見せ方だけである。
    AutomationId は 1 つも改名・削除していない（変種の選びは詳細の畳みへ**要素ごと**移した）。
  -->
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <!--
      動かし方の一覧の行に出す札＝RuntimeVariants.ShortDisplayName（段 G・high 14 → 決裁 135 ⑶）。
      束縛の値は台帳の綴りのままなので settings.json の variant は 1 字も動かない。
      ItemContainerStyle の 2 行は SettingsView.xaml と**同じ理由**＝効いているのは
      読み上げ機（UI Automation）の名の 1 行で、ContentTemplate は念のためである
      （項目の器には ItemTemplate が局所値で入るので Style の Setter より強い）＝是正・v2.0.1。
    -->
    <v:VariantDisplayConverter x:Key="VariantDisplay" />
    <DataTemplate x:Key="VariantRow">
      <TextBlock Text="{Binding Converter={StaticResource VariantDisplay}}" />
    </DataTemplate>
    <Style x:Key="VariantItem" TargetType="ComboBoxItem">
      <Setter Property="ContentTemplate" Value="{StaticResource VariantRow}" />
      <Setter Property="AutomationProperties.Name"
              Value="{Binding Converter={StaticResource VariantDisplay}}" />
    </Style>
  </Window.Resources>

  <DockPanel Margin="16">

    <!-- 見出し -->
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
      <StackPanel Orientation="Horizontal">
        <TextBlock FontSize="18" FontWeight="Bold"
                   AutomationProperties.AutomationId="FirstRunStepTitle"
                   Text="{Binding StepTitle, Mode=OneWay}" />
        <TextBlock Margin="12,0,0,0" VerticalAlignment="Bottom" Foreground="#666666"
                   AutomationProperties.AutomationId="FirstRunStepNumber"
                   Text="{Binding StepNumberText, Mode=OneWay}" />
      </StackPanel>
    </StackPanel>

    <!-- 下の操作帯 -->
    <Border DockPanel.Dock="Bottom" Padding="0,12,0,0">
      <StackPanel>
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                   AutomationProperties.AutomationId="FirstRunMessageText"
                   Text="{Binding Message, Mode=OneWay}" />
        <!--
          釦は**出せる段にだけ出す**（v2-spec.md §3 段 3＝働いている間は〔やめる〕だけ・
          v2-copy.md §2 完了＝〔しゃべらせてみる〕だけ）。灰色の釦を並べない＝
          押せない札が 3 つ見えている画面は「どれかが効くのでは」と読ませる。
          **要素も id も残す**（BackVisible／IsBusy は Command の可否と同じ式）。
        -->
        <StackPanel Orientation="Horizontal">
          <Button Content="{x:Static vm:UiStrings.WizardBackButton}" Padding="14,5" Margin="0,0,8,0"
                  AutomationProperties.AutomationId="FirstRunBackButton"
                  Visibility="{Binding BackVisible, Converter={StaticResource BoolToVis}}"
                  Command="{Binding BackCommand}" />
          <Button Padding="18,5" Margin="0,0,8,0"
                  AutomationProperties.AutomationId="FirstRunNextButton"
                  Content="{Binding NextButtonText, Mode=OneWay}"
                  Command="{Binding NextCommand}" />
          <Button Content="{x:Static vm:UiStrings.WizardCancelButton}" Padding="14,5"
                  AutomationProperties.AutomationId="FirstRunCancelButton"
                  Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                  Command="{Binding CancelCommand}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!--
      詳細（上級者向け）＝この 1 枚だけ（既定は閉）。中身はいまの段で入れ替える。
      台本は Open-YwkFold -Id 'FirstRunAdvancedExpander' の 1 手で開ける（v2-plan.md A-0）。
    -->
    <Expander DockPanel.Dock="Bottom" Margin="0,10,0,0"
              Header="{x:Static vm:UiStrings.AdvancedHeader}"
              AutomationProperties.AutomationId="FirstRunAdvancedExpander"
              Visibility="{Binding HasAdvanced, Converter={StaticResource BoolToVis}}">
      <Grid Margin="0,8,0,0">

        <!-- 段 2 の詳細＝動かし方を自分で選ぶ（下限未満は選べない錠はここで働く＝裁定 126 の B） -->
        <StackPanel Visibility="{Binding IsVariantStep, Converter={StaticResource BoolToVis}}">
          <TextBlock Text="{x:Static vm:UiStrings.WizardPickVariant}" FontWeight="Bold" Margin="0,0,0,6" />
          <ComboBox Width="420" HorizontalAlignment="Left"
                    AutomationProperties.AutomationId="FirstRunVariantCombo"
                    ItemsSource="{Binding VariantChoices}"
                    ItemTemplate="{StaticResource VariantRow}"
                    ItemContainerStyle="{StaticResource VariantItem}"
                    SelectedItem="{Binding Variant, Mode=TwoWay}" />
          <TextBlock Margin="0,8,0,0" TextWrapping="Wrap"
                     AutomationProperties.AutomationId="FirstRunVariantNameText"
                     Text="{Binding VariantDisplayName, Mode=OneWay}" />
          <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#555555"
                     AutomationProperties.AutomationId="FirstRunVariantNoteText"
                     Text="{Binding VariantNote, Mode=OneWay}" />
          <TextBlock Margin="0,12,0,0" TextWrapping="Wrap"
                     AutomationProperties.AutomationId="FirstRunDriverText"
                     Text="{Binding DriverText, Mode=OneWay}" />
          <!-- ドライバの下限に届かない動かし方を選んでいる間の 1 行（裁定 126 の B）＝
               この間は「準備を始める」が押せない（CanGoNext）。 -->
          <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" FontWeight="Bold" Foreground="#B00020"
                     AutomationProperties.AutomationId="FirstRunVariantBlockText"
                     Visibility="{Binding VariantBlocked, Converter={StaticResource BoolToVis}}"
                     Text="{Binding VariantBlockReason, Mode=OneWay}" />
          <TextBlock Margin="0,12,0,0" FontWeight="Bold" Text="{x:Static vm:UiStrings.WizardSizeHeader}" />
          <TextBlock Margin="0,4,0,0" TextWrapping="Wrap"
                     AutomationProperties.AutomationId="FirstRunSizeText"
                     Text="{Binding SizeText, Mode=OneWay}" />
          <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#666666" FontSize="11"
                     Text="{x:Static vm:UiStrings.WizardVerifyNote}" />
        </StackPanel>

        <!-- 段 3 の詳細＝速さ・件数・残りバイトと、済んだ段の記録 -->
        <DockPanel Visibility="{Binding IsWorkStep, Converter={StaticResource BoolToVis}}">
          <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="#555555"
                     AutomationProperties.AutomationId="FirstRunProgressDetailText"
                     Text="{Binding ProgressDetailText, Mode=OneWay}" />
          <ListBox Margin="0,8,0,0" Height="140"
                   AutomationProperties.AutomationId="FirstRunTrailList"
                   ItemsSource="{Binding Trail}" />
        </DockPanel>

        <!-- 完了の詳細＝何をしたかの記録 -->
        <ListBox Height="180"
                 Visibility="{Binding IsDoneStep, Converter={StaticResource BoolToVis}}"
                 AutomationProperties.AutomationId="FirstRunDoneTrailList"
                 ItemsSource="{Binding Trail}" />
      </Grid>
    </Expander>

    <Grid>
      <!-- 段 1／3 ＝ お知らせ（要約＋〔全文を見る〕＋同意 1 度＝決裁 130 Q3） -->
      <DockPanel Visibility="{Binding IsNoticesStep, Converter={StaticResource BoolToVis}}">
        <!--
          お知らせの全文を読み込めていないときは同意できない（裁定 46）。
          印を付けられてしまうと acceptedNoticesSha256 に null が残り、
          LGPL-2.1 の libsndfile の通知（裁定 28）を出さずに取得へ進む路ができる。
        -->
        <CheckBox DockPanel.Dock="Bottom" Margin="0,10,0,0"
                  Content="{x:Static vm:UiStrings.WizardAcceptCheck}"
                  AutomationProperties.AutomationId="FirstRunAcceptCheck"
                  Visibility="{Binding NoticesReadable, Converter={StaticResource BoolToVis}}"
                  IsEnabled="{Binding CanAcceptNotices, Mode=OneWay}"
                  IsChecked="{Binding Accepted, Mode=TwoWay}" />
        <!--
          W1＝全文が読めない回は**要約もチェックも出さない**（v2-copy.md §2 段 1）。
          差し替えの 1 行はここに出す＝畳み（FirstRunNoticesExpander・既定は閉）の中だけに
          置いていたころは、押せないチェックと効かない〔次へ〕しか見えなかった。
        -->
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" LineHeight="22"
                   FontSize="14" FontWeight="Bold"
                   AutomationProperties.AutomationId="FirstRunNoticesUnreadableText"
                   Visibility="{Binding NoticesUnreadable, Converter={StaticResource BoolToVis}}"
                   Text="{Binding NoticesUnreadableText, Mode=OneWay}" />
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" LineHeight="22"
                   AutomationProperties.AutomationId="FirstRunNoticesSummaryText"
                   Visibility="{Binding NoticesReadable, Converter={StaticResource BoolToVis}}"
                   Text="{Binding NoticesSummaryText, Mode=OneWay}" />
        <Button DockPanel.Dock="Top" HorizontalAlignment="Left" Margin="0,12,0,0" Padding="14,5"
                Content="{x:Static vm:UiStrings.WizardNoticesFullButton}"
                AutomationProperties.AutomationId="FirstRunNoticesFullButton"
                Visibility="{Binding NoticesReadable, Converter={StaticResource BoolToVis}}"
                Click="OnNoticesFullClick" />
        <Expander x:Name="FirstRunNoticesExpander" Margin="0,10,0,0" Header="{x:Static vm:UiStrings.WizardNoticesHeader}"
                  AutomationProperties.AutomationId="FirstRunNoticesExpander"
                  Visibility="{Binding NoticesReadable, Converter={StaticResource BoolToVis}}">
          <TextBox AutomationProperties.AutomationId="FirstRunNoticesBox"
                   Height="240" Margin="0,8,0,0"
                   IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                   VerticalScrollBarVisibility="Auto"
                   Text="{Binding NoticesText, Mode=OneWay}" />
        </Expander>
      </DockPanel>

      <!-- 段 2／3 ＝ これからすること（確かめるだけ・選ばせない＝決裁 130 Q1） -->
      <StackPanel Visibility="{Binding IsVariantStep, Converter={StaticResource BoolToVis}}">
        <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="24"
                   AutomationProperties.AutomationId="FirstRunDecisionText"
                   Text="{Binding DecisionLine, Mode=OneWay}" />
        <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" FontSize="14" LineHeight="24"
                   FontWeight="Bold"
                   AutomationProperties.AutomationId="FirstRunPlanText"
                   Text="{Binding PlanText, Mode=OneWay}" />
        <!--
          ⑶ なぜ落ちるのか（憲章 原則 3＝釦を押す前の 1 画面に ⑴ 量 ⑵ 時間 ⑶ なぜ が全部載る）。
          お知らせに同意済みの回は段 1 を飛ばす（決裁 130 Q3）ので、この 1 文が無いと
          〔はじめの準備をやり直す〕から入った利用者は「なぜ」を 1 度も読まない。
        -->
        <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" FontSize="14" LineHeight="24"
                   AutomationProperties.AutomationId="FirstRunWhyText"
                   Text="{Binding WhyText, Mode=OneWay}" />
        <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#555555"
                   Text="{Binding ResumeText, Mode=OneWay}" />
      </StackPanel>

      <!-- 段 3／3 ＝ 準備しています（1 本のバー・4 段を 1 つに見せる） -->
      <StackPanel Visibility="{Binding IsWorkStep, Converter={StaticResource BoolToVis}}">
        <ProgressBar Height="18"
                     AutomationProperties.AutomationId="FirstRunProgressBar"
                     Minimum="0" Maximum="1"
                     Value="{Binding ProgressFraction, Mode=OneWay}" />
        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" FontSize="14" FontWeight="Bold"
                   AutomationProperties.AutomationId="FirstRunProgressText"
                   Text="{Binding ProgressText, Mode=OneWay}" />
        <TextBlock Margin="0,10,0,0" TextWrapping="Wrap"
                   AutomationProperties.AutomationId="FirstRunPhaseText"
                   Text="{Binding PhaseText, Mode=OneWay}" />
        <TextBlock Margin="0,14,0,0" TextWrapping="Wrap" Foreground="#555555"
                   Text="{Binding WaitText, Mode=OneWay}" />
        <!-- Windows の許可の窓が出る直前だけ（憲章 §4-9） -->
        <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" FontWeight="Bold"
                   AutomationProperties.AutomationId="FirstRunUacNoticeText"
                   Visibility="{Binding UacNoticeVisible, Converter={StaticResource BoolToVis}}"
                   Text="{Binding UacNoticeText, Mode=OneWay}" />
      </StackPanel>

      <!-- 完了 -->
      <!--
        題（FirstRunStepTitle＝Title(Done)＝FirstRunViewModel.TitleDone）が既に「使えます。」を
        名乗っている。ここに同じ字を 2 度目として綴らない（文言表を直したときに片方だけ残る）。
      -->
      <StackPanel Visibility="{Binding IsDoneStep, Converter={StaticResource BoolToVis}}">
        <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" FontSize="14" LineHeight="24"
                   AutomationProperties.AutomationId="FirstRunDoneText"
                   Text="{Binding DoneText, Mode=OneWay}" />
      </StackPanel>
    </Grid>

  </DockPanel>
</Window>
