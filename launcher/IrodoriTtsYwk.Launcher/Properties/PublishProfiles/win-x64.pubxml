<?xml version="1.0" encoding="utf-8"?>
<!--
  配布の発行形（裁定 51＝SelfContained publish の 1 exe）。
  .NET ランタイム（MIT・licenses/dotnet/）を自作分と一緒に焼く＝利用者に .NET の別途導入を求めない。
  第三者物（MSVC・NVIDIA・LGPL）は焼かない＝それらは取得台帳（ledger/*.json）で利用者機が取る。

  使い方＝
    dotnet publish launcher/IrodoriTtsYwk.Launcher/IrodoriTtsYwk.Launcher.csproj ^
      -p:PublishProfile=win-x64 -p:UpstreamIrodoriTts=<sha> -p:UpstreamIrodoriTtsServer=<sha>
  （build/release-build.ps1 がこの 1 行を包み、混入検分・pdb 退避・版刻印 zip まで通す）
-->
<Project>
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- WPF は単一檔からの自己展開でネイティブ檔を要する -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- トリムは行わない＝System.Text.Json の反射経路（台帳・settings.json）を壊さない -->
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <DebugType>portable</DebugType>
    <!-- pdb は成果物に混ぜず release-build.ps1 が別に退避する（本体の型） -->
    <DebugSymbols>true</DebugSymbols>
    <!-- プロジェクトディレクトリからの相対＝<リポ>\build\out\launcher\win-x64\（build/out は .gitignore 済み） -->
    <PublishDir>..\..\build\out\launcher\win-x64\</PublishDir>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
</Project>
