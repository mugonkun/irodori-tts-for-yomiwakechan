<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>IrodoriTtsYwk.Launcher.Tests</RootNamespace>
    <!-- 参照先が WPF のアセンブリなので、同じ土台を引く
         （WinForms は裁定 126 の A でトレイごと落とした＝ここも引かない） -->
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <!--
    テストは**純ロジックだけ**（依頼文の作法）。継ぎ目は public コンストラクタで、
    InternalsVisibleTo は使わない（本体 yomiwakechan2 の流儀）。
    版は機体の NuGet キャッシュに在る物に固定＝外に出ずに復元できる。
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\IrodoriTtsYwk.Launcher\IrodoriTtsYwk.Launcher.csproj" />
  </ItemGroup>

  <!--
    AutomationId 生存（v2.0 段 A）＝画面の檔そのものを試験の出力へ写す。
    AppContext.BaseDirectory から読むので、試験がリポの路を探し歩かない。

    **写す前に棚を空にする**（是正・検分）＝`PreserveNewest` は写すだけで消さないので、
    Views から画面の檔を 1 枚落としても出力には前の写しが残り、
    「id が 1 つも消えていない」錠が**古い写しで素通りする**。7 枚だけを毎度写し直す。
  -->
  <Target Name="CleanCopiedViews" BeforeTargets="PrepareForBuild">
    <RemoveDir Directories="$(OutputPath)Views" />
    <RemoveDir Directories="$(OutputPath)ViewModelsSource" />
    <RemoveDir Directories="$(OutputPath)ProbeScripts" />
  </Target>

  <ItemGroup>
    <None Include="..\IrodoriTtsYwk.Launcher\Views\*.xaml"
          CopyToOutputDirectory="PreserveNewest"
          LinkBase="Views" />
    <!--
      語の検分（WordLintTests）が舐める ViewModel の**原文**。`None` なので二重に建たない。
      是正・段 C の検分＝UiStrings と XAML だけでは「ViewModel が組み立てて束縛に載せる 1 行」が
      1 つも見えず、隠す語が 6 本素通りしていた。
    -->
    <None Include="..\IrodoriTtsYwk.Launcher\ViewModels\*.cs"
          CopyToOutputDirectory="PreserveNewest"
          LinkBase="ViewModelsSource" />
    <!--
      無人検分の台本。AutomationIdsTests が「畳みの中の id を台本が開けるか」を見るのに読む
      （是正・段 C の検分＝id が在るだけでは触れない＝畳んだ Expander は UIA から見えない）。
    -->
    <None Include="..\..\probe\d-launch-probe.ps1"
          CopyToOutputDirectory="PreserveNewest"
          LinkBase="ProbeScripts" />
    <None Include="..\..\probe\wizard-probe.ps1"
          CopyToOutputDirectory="PreserveNewest"
          LinkBase="ProbeScripts" />
  </ItemGroup>

</Project>
