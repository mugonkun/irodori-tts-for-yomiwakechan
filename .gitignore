# Visual Studio / .NET
.vs/
bin/
obj/
# research/lab/bin/ は調査台本の置き場（Visual Studio の bin/ ではない）
!research/lab/bin/
*.user
*.suo

# Claude Code のローカル設定・worktree
.claude/settings.local.json
.claude/worktrees/

# 第三者バイナリはコミットしない（取得台帳 URL＋sha256 だけを持つ＝停止域）
*.whl
*.dll
*.exe
*.pyd
*.zip
*.7z
*.msi

# モデル重み・音声の生成物・実験出力
*.safetensors
*.ckpt
*.pt
*.pth
*.onnx
*.npz
*.bin
build/out/
build/runtime/
build/cache/
installer/output/
installer/runtime/
dist/
out/
# research/lab/out/ は調査の生データの写し（軽い JSON・index HTML のみ）
!research/lab/out/

# 埋め込み Python・venv・キャッシュ
python-embed*/
.venv*/
venv/
__pycache__/
*.pyc
.uv-cache/
.pytest_cache/

# ローカル設定（機械ごとに違う）
*.local.json
.env
.env.*

# ログ・一時
*.log
*.tmp
